# Public site configuration. Copy this file to `.env.local` and adjust as needed.

# Canonical base URL of the deployed site (used by sitemap/robots metadata
# and to resolve Open Graph images).
NEXT_PUBLIC_SITE_URL=https://thrive-lab.example.org

# Contact form delivery. When NEXT_PUBLIC_FORM_ENDPOINT is set, submissions
# are POSTed to this URL (e.g. a serverless email relay or a form service).
# When empty, the form simulates a successful submission in the browser
# (build-time safe, no credentials needed).
NEXT_PUBLIC_FORM_ENDPOINT=

# Lab-wide contact email shown to visitors. All inquiries route to this
# shared inbox; individual member addresses are never displayed.
NEXT_PUBLIC_CONTACT_EMAIL=thrivelab@vcu.edu
